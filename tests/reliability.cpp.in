static void win_perrorA(const char *) {}
static DWORD RtlNtStatusToDosError(NTSTATUS s) { return s; }
static size_t wide_length(LPCWSTR p) { size_t n = 0; while (p[n]) ++n; return n; }
static int test_wcscmp(LPCWSTR a, LPCWSTR b) {
    while (*a && *a == *b) { ++a; ++b; } return *a - *b;
}
#define wcscmp test_wcscmp
static std::string narrow(PUNICODE_STRING p) {
    std::string s; for (size_t i = 0; i < p->Length / 2; ++i) s += char(p->Buffer[i]);
    return s;
}
static void RtlInitUnicodeString(PUNICODE_STRING p, LPCWSTR s) {
    p->Buffer = const_cast<PWSTR>(s); p->Length = USHORT(wide_length(s) * 2);
    p->MaximumLength = p->Length;
}
static void InitCountedUnicodeString(PUNICODE_STRING p, PWSTR s, USHORT n) {
    p->Buffer = s; p->Length = p->MaximumLength = n;
}
static void RtlCopyUnicodeString(PUNICODE_STRING a, PUNICODE_STRING b) {
    assert(a->MaximumLength >= b->Length); memmove(a->Buffer, b->Buffer, b->Length);
    a->Length = b->Length;
}
static NTSTATUS RtlAppendUnicodeStringToString(PUNICODE_STRING a, PUNICODE_STRING b) {
    if (a->Length + b->Length > a->MaximumLength) return -1;
    memmove((BYTE *)a->Buffer + a->Length, b->Buffer, b->Length);
    a->Length += b->Length; return 0;
}
static NTSTATUS RtlAppendUnicodeToString(PUNICODE_STRING a, LPCWSTR s) {
    UNICODE_STRING b; RtlInitUnicodeString(&b, s); return RtlAppendUnicodeStringToString(a, &b);
}
static void RtlInitAnsiString(ANSI_STRING *s, const char *p) { s->Buffer = p; }
static NTSTATUS RtlAnsiStringToUnicodeString(PUNICODE_STRING p, ANSI_STRING *s, BOOL) {
    size_t n = strlen(s->Buffer); if (n * 2 > p->MaximumLength) return -1;
    for (size_t i = 0; i < n; ++i) p->Buffer[i] = s->Buffer[i];
    p->Length = USHORT(n * 2); return 0;
}
static NTSTATUS RtlUnicodeStringToOemString(OEM_STRING *, PUNICODE_STRING, BOOL) { return -1; }
static void RtlFreeOemString(OEM_STRING *) {}
static void SplitPath(PUNICODE_STRING s, PUNICODE_STRING a, PUNICODE_STRING b) {
    *b = *s; RtlInitUnicodeString(a, L".");
    for (size_t i = 0; i < s->Length / 2; ++i) if (s->Buffer[i] == L'\\') {
        *a = *s; a->Length = USHORT(i * 2);
        b->Buffer = s->Buffer + i + 1; b->Length = s->Length - USHORT((i + 1) * 2);
    }
}
template<typename T> struct WHeapMem {
    std::vector<T> v; WHeapMem(size_t n, int) : v(n) {}
    size_t Count() const { return v.size(); } operator T *() { return v.data(); }
};

// INSERT_LINK_TRACKER

struct File {
    std::vector<BYTE> bytes;
    size_t pos = 0, failAfter = size_t(-1), maxRead = size_t(-1), entry = 0;
    bool directory = false, openError = false, pipe = false, zeroEOF = false;
    bool failedReadBytes = false, writingData = false, deleteError = false, countOnly = false;
    size_t writeFailAfter = size_t(-1), bytesWritten = 0;
    DWORD attributes = 0, links = 0, identity = 0;
    unsigned deletes = 0, resets = 0, writeAborts = 0, writeCalls = 0;
    unsigned closes = 0, aborts = 0, opens = 0;
    std::vector<std::string> children, lines;
    std::vector<DWORD> reads;
};
typedef File *HANDLE;
#define INVALID_HANDLE_VALUE ((HANDLE)-1)
static std::map<std::string, File> files;
static File input;
static std::map<std::string, File> outputFiles;
static HANDLE GetStdHandle(int) { return &input; }
static HANDLE GetCurrentProcess() { return NULL; }
const DWORD DUPLICATE_SAME_ACCESS = 2;
static BOOL DuplicateHandle(HANDLE, HANDLE source, HANDLE, HANDLE *target, DWORD, BOOL, DWORD) {
    *target = source; return TRUE;
}
static HANDLE NativeOpenFile(HANDLE, PUNICODE_STRING name, int, int, int, int) {
    std::string key = narrow(name); if (key.empty()) key = ".";
    File &f = files[key]; ++f.opens;
    if (f.openError) { lastError = 9; return INVALID_HANDLE_VALUE; }
    return &f;
}
static BOOL GetFileInformationByHandle(HANDLE f, PBY_HANDLE_FILE_INFORMATION info) {
    memset(info, 0, sizeof(*info));
    info->dwFileAttributes = (f->directory ? FILE_ATTRIBUTE_DIRECTORY : 0) | f->attributes;
    info->nNumberOfLinks = f->links; info->nFileIndexLow = f->identity;
    return TRUE;
}
static void NtClose(HANDLE f) { assert(f && f != INVALID_HANDLE_VALUE); ++f->closes; }
#define CloseHandle NtClose
static BOOL NativeDeleteFile(HANDLE f) { ++f->deletes; return !f->deleteError; }
static BOOL NativeSetFileAttributes(HANDLE f, DWORD a) { ++f->resets; f->attributes = a; return TRUE; }
static DWORD SetFilePointer(HANDLE, DWORD low, LONG *, DWORD) { return low; }
static BOOL SetEndOfFile(HANDLE) { return TRUE; }
static BOOL DeviceIoControl(HANDLE, DWORD, LPVOID, DWORD, LPVOID, DWORD, DWORD *, LPVOID) { return TRUE; }
static HANDLE NativeCreateFile(HANDLE, PUNICODE_STRING name, DWORD, DWORD, LPVOID,
    LPVOID, DWORD, DWORD, DWORD, DWORD, BOOL) {
    File &f = outputFiles[narrow(name)]; ++f.opens;
    return f.openError ? INVALID_HANDLE_VALUE : &f;
}
static BOOL ReadFile(HANDLE f, LPBYTE p, DWORD n, DWORD *done, LPVOID) {
    f->reads.push_back(n);
    *done = DWORD(std::min(size_t(n), std::min(f->bytes.size() - f->pos, f->maxRead)));
    if (!*done && f->pipe) { lastError = ERROR_BROKEN_PIPE; return FALSE; }
    if (*done) memcpy(p, f->bytes.data() + f->pos, *done); f->pos += *done; return TRUE;
}
static BOOL WriteFile(HANDLE f, const void *p, DWORD n, DWORD *done, LPVOID) {
    ++f->writeCalls;
    if (f->bytesWritten >= f->writeFailAfter) { lastError = 9; *done = 0; return FALSE; }
    n = DWORD(std::min(size_t(n), f->writeFailAfter - f->bytesWritten));
    const BYTE *b = (const BYTE *)p;
    if (f->countOnly) f->bytes.assign(b, b + std::min(n, DWORD(24)));
    else f->bytes.insert(f->bytes.end(), b, b + n);
    f->bytesWritten += n; *done = n; return TRUE;
}
static BOOL BackupRead(HANDLE f, LPBYTE p, DWORD n, DWORD *done, BOOL abort, BOOL, LPVOID *ctx) {
    if (abort) { if (*ctx) ++((File *)*ctx)->aborts; *ctx = NULL; return TRUE; }
    assert(n > sizeof(WIN32_STREAM_ID));
    *ctx = f;
    if (f->pos >= f->failAfter) {
        lastError = 9; *done = 0;
        if (f->zeroEOF) return TRUE;
        if (f->failedReadBytes) { memset(p, 0xEE, n); *done = n; }
        return FALSE;
    }
    n = DWORD(std::min(size_t(n), f->failAfter - f->pos));
    return ReadFile(f, p, n, done, NULL);
}
static BOOL BackupWrite(HANDLE f, LPBYTE p, DWORD n, DWORD *done, BOOL abort, BOOL, LPVOID *ctx) {
    if (abort) { if (*ctx) ++((File *)*ctx)->writeAborts; *ctx = NULL; return TRUE; }
    ++f->writeCalls;
    if (f->bytesWritten >= f->writeFailAfter) { lastError = 9; *ctx = f; *done = 0; return FALSE; }
    bool first = !*ctx; *ctx = f;
    f->bytesWritten += n; *done = n;
    if (first) {
        WIN32_STREAM_ID h; memcpy(&h, p, HEADER_SIZE);
        assert(h.dwStreamId != BACKUP_INVALID); // control records never reach BackupWrite
        f->writingData = h.dwStreamId == BACKUP_DATA;
        DWORD skip = HEADER_SIZE + h.dwStreamNameSize;
        assert(n >= skip); p += skip; n -= skip;
    }
    if (f->writingData) f->bytes.insert(f->bytes.end(), p, p + n);
    return TRUE;
}
struct Finder {
    struct { DWORD FileNameLength; USHORT ShortNameLength; WCHAR ShortName[13]; } Base;
    WCHAR FileName[128]; bool valid = false;
    bool load(HANDLE f) {
        valid = f->entry < f->children.size(); if (!valid) return false;
        std::string s = f->children[f->entry]; Base.FileNameLength = DWORD(s.size() * 2);
        Base.ShortNameLength = 0;
        for (size_t i = 0; i < s.size(); ++i) FileName[i] = s[i];
        return true;
    }
    bool FindFirst(HANDLE f) { f->entry = 0; return load(f); }
    bool FindFirst(HANDLE, PUNICODE_STRING) { return false; }
    bool FindNext(HANDLE f) { ++f->entry; return load(f); }
    operator bool() const { return valid; }
    DWORD GetLastWin32Error() const { return ERROR_NO_MORE_FILES; }
};
struct WOverlappedIOC {
    operator bool() const { return true; }
    size_t LineRecv(HANDLE f, char *p, DWORD) {
        if (f->entry == f->lines.size()) { lastError = ERROR_HANDLE_EOF; return 0; }
        std::string s = f->lines[f->entry++]; strcpy(p, s.c_str()); return s.size();
    }
    size_t LineRecvW(HANDLE f, PWSTR p, DWORD) {
        char s[128]; size_t n = LineRecv(f, s, 128);
        for (size_t i = 0; i < n; ++i) p[i] = s[i]; return n * 2;
    }
};

class StrArc {
public:
    class FileCopyContext;
    bool BackupCopyFile(HANDLE, HANDLE, PUNICODE_STRING, PUNICODE_STRING);
    enum { XE_NOERROR, XE_CANCELLED, XE_FILE_IO, XE_ARCHIVE_IO, XE_ARCHIVE_TRUNC,
           XE_BAD_BUFFER, XE_NOT_ENOUGH_MEMORY, XE_ARCHIVE_BAD_HEADER, XE_NOT_ENOUGH_MEMORY_FOR_LINK_TRACKER };
    enum { BACKUP_METHOD_COPY, BACKUP_METHOD_FULL, BACKUP_METHOD_DIFF, BACKUP_METHOD_INC };
    DWORD dwBufferSize, dwArchiveBytesBuffered = 0;
    std::vector<BYTE> storage;
    LPBYTE Buffer;
    LPBYTE BackupPrefix = NULL;
    HANDLE hArchive, RootDirectory = NULL;
    WCHAR path[32768];
    UNICODE_STRING FullPath;
    Finder finddata;
    bool bBackupFailed = false, bCancel = false, bVerbose = false, bListOnly = false;
    bool bRestoreMode = false, bTestMode = false, bRestoreEntryFailed = false;
    bool bRestoreDirectory = false, bRestoreCompression = true, skipRestore = false;
    DWORD dwCreateOption = 0;
    LinkTrackerItem *LinkTrackerItems[256] = {};
    bool bLocal = false, bListFiles = false, bBackupRegistrySnapshots = false;
    bool bHardLinkSupport = false, bSkipShortNames = true, bProcessSecurity = false;
    bool bFilesFromStdIn = false, bFilesFromStdInUnicode = false;
    int BackupMethod = BACKUP_METHOD_COPY;
    unsigned long long FileCounter = 0, FailedFileCounter = 0;
    std::map<std::string, std::vector<BYTE> > restored;
    explicit StrArc(HANDLE archive, DWORD size = 65536) :
        dwBufferSize(size), storage(size), Buffer(storage.data()), hArchive(archive) {
        FullPath.Buffer = path; FullPath.Length = 0; FullPath.MaximumLength = 65534;
    }
    ~StrArc() {
        free(BackupPrefix);
        for (unsigned i = 0; i < 256; ++i)
            while (LinkTrackerItems[i]) LinkTrackerItems[i] = LinkTrackerItems[i]->DeleteAndGetNext();
    }
    DWORD GetDataOffset() { return HEADER_SIZE + header->dwStreamNameSize; }
    void Exception(int code) { throw code; }
    void ExcludedString(PUNICODE_STRING, PBY_HANDLE_FILE_INFORMATION, bool *ex, bool *in) {
        *ex = false; *in = true;
    }
    // Only base-file open/filter/final metadata are substituted. Stream parsing,
    // payload handling, abort cleanup and archive traversal are production code.
    bool RestoreFile(PUNICODE_STRING name, PBY_HANDLE_FILE_INFORMATION info, PUNICODE_STRING) {
        std::string key = narrow(name);
        File &f = outputFiles[key];
        bRestoreEntryFailed = false;
        bRestoreDirectory = (info->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
        f.directory = bRestoreDirectory;
        bool seek = bTestMode || skipRestore;
        HANDLE h = seek ? INVALID_HANDLE_VALUE : &f;
        bool result = WriteFileFromArchive(name, h, seek);
        if (bRestoreEntryFailed) DiscardFileFromArchive(name, h);
        else if (!skipRestore) ++FileCounter;
        if (h != INVALID_HANDLE_VALUE) NtClose(h);
        if ((!f.deletes || f.deleteError) && !bTestMode && !skipRestore) restored[key] = f.bytes;
        return result;
    }
    bool WriteFileHardLinkFromArchive(HANDLE &, DWORD, PUNICODE_STRING, bool) {
        assert(false && "hard-link extraction belongs to native smoke tests"); return false;
    }
    // INSERT_PRODUCTION_METHODS
};

// Synchronous in-memory substitute only for the copy helper's thread/pipe
// plumbing. Both stream sessions and BackupCopyFile itself use production code.
class StrArc::FileCopyContext {
    File pipe;
    StrArc source, target;
    HANDLE sourceHandle;
    PUNICODE_STRING sourceName;
    bool sourceResult = false;
public:
    FileCopyContext(StrArc *, DWORD size, PUNICODE_STRING name, HANDLE handle,
        PUNICODE_STRING, HANDLE) : source(&pipe, size), target(&pipe, size),
        sourceHandle(handle), sourceName(name) {}
    bool operator!() { return false; }
    bool StartSourceReadThread() {
        sourceResult = source.ReadFileStreamsToArchive(sourceName, sourceHandle);
        return true;
    }
    bool GetSourceReadThreadResult() { return sourceResult; }
    StrArc *GetTargetWriteSession() { return &target; }
};

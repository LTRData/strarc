const DWORD HEADER_SIZE = 20, STRARC_MAGIC = 0xBAC00001, BACKUP_INVALID = 0;
const DWORD STRARC_FAILED_FILE = 0xBAC00002;
const DWORD BACKUP_ALTERNATE_DATA = 4, BACKUP_SPARSE_BLOCK = 9;
const DWORD STREAM_SPARSE_ATTRIBUTE = 8, STREAM_NORMAL_ATTRIBUTE = 0;

const int FILE_WRITE_ATTRIBUTES = 0, FILE_SHARE_READ = 0, FILE_SHARE_WRITE = 0;
const int FILE_SHARE_DELETE = 0, FILE_OPEN_FOR_BACKUP_INTENT = 0;
const int FILE_SEQUENTIAL_ONLY = 0, FILE_OPEN_REPARSE_POINT = 0, FILE_LIST_DIRECTORY = 0;
